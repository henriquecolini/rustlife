// What shots and blasts look like, read by the client. Sprites are the
// mounted game's materials (relative to materials/, without extension),
// drawn on quads facing the camera. Sizes are units.
Effects(
    // A gun going off: one of these at random, briefly, at the muzzle.
    muzzle_flash: (
        sprites: ["effects/muzzleflash1", "effects/muzzleflash2", "effects/muzzleflash3"],
        size: 16.0,
        // At the view model's muzzle, which is much nearer the eye.
        view_size: 5.0,
        duration: 0.05,
    ),
    // A streak flying from the gun to where the bullet stopped.
    tracer: (
        sprite: "effects/tracer_middle",
        width: 1.5,
        length: 140.0,
        speed: 7000.0,
    ),
    // Sparks where a bullet or swing strikes.
    impact: (
        sprite: "effects/spark",
        size: 10.0,
        duration: 0.12,
    ),
    // A blast, drawn as particles the game makes itself: a fireball of
    // overlapping puffs (its size a share of the blast's radius, its centre
    // lifted by a share of its size, since fireballs rise and the floor
    // would cut one centred on it in half), smoke, sparks and a shockwave.
    // The view shakes for those near it, `shake` right at the blast down to
    // nothing at three times its radius.
    explosion: (
        size_per_radius: 0.8,
        rise: 0.35,
        fireballs: 14,
        smoke: 16,
        sparks: 44,
        duration: 0.7,
        smoke_duration: 4.5,
        shake: 0.85,
    ),
    // A thrown grenade: a red dot on its top that flashes with each tick of
    // its fuse (the dot's size at the flash, how bright it stays between
    // ticks, how long a flash takes to fade) and a red trail of where it has
    // been (its life, its width at the grenade and at its far end).
    grenade: (
        dot_size: 9.0,
        dot_offset: (0.0, 0.0, 5.2),
        dot_color: (1.6, 0.08, 0.03),
        dot_dim: 0.4,
        flash_fade: 0.22,
        trail_life: 0.55,
        trail_width: (3.0, 0.3),
        trail_color: (1.4, 0.05, 0.02),
        trail_alpha: 0.85,
    ),
)
