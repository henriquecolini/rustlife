// What shots and blasts look like, read by the client. Sprites are the
// mounted game's materials (relative to materials/, without extension),
// drawn on quads facing the camera. Sizes are units. An entry's `pcf` names a
// particle system of the game's own `particles/*.pcf` files, played in place of
// the sprites and particles described beside it; those are the fallback when
// the game has no such system.
Effects(
    // A gun going off: one of these at random, briefly, at the muzzle.
    muzzle_flash: (
        sprites: ["effects/muzzleflash1", "effects/muzzleflash2", "effects/muzzleflash3"],
        size: 16.0,
        // At the view model's muzzle, which is much nearer the eye.
        view_size: 5.0,
        duration: 0.05,
    ),
    // A streak flying from the gun to where the bullet stopped.
    tracer: (
        sprite: "effects/tracer_middle",
        width: 1.5,
        length: 140.0,
        speed: 7000.0,
    ),
    // What a bullet throws off the surface it strikes and the mark it leaves,
    // by the surface's class (from its $surfaceprop); "default" catches the
    // rest. Decals are the game's materials, projected onto the surface.
    bullet_impacts: {
        "default": (
            sprites: ["effects/fleck_cement1", "effects/fleck_cement2"],
            size: 1.4,
            speed: 110.0,
            particles: 7,
            duration: 0.35,
            color: (0.42, 0.38, 0.33),
            lit: false,
            decals: ["decals/concrete/shot1", "decals/concrete/shot2", "decals/concrete/shot3", "decals/concrete/shot4", "decals/concrete/shot5"],
            decal_size: 9.0,
            decal_life: 30.0,
            pcf: Some("impact_concrete"),
        ),
        "concrete": (
            sprites: ["effects/fleck_cement1", "effects/fleck_cement2"],
            size: 1.4,
            speed: 110.0,
            particles: 7,
            duration: 0.35,
            color: (0.42, 0.38, 0.33),
            lit: false,
            decals: ["decals/concrete/shot1", "decals/concrete/shot2", "decals/concrete/shot3", "decals/concrete/shot4", "decals/concrete/shot5"],
            decal_size: 9.0,
            decal_life: 30.0,
            pcf: Some("impact_concrete"),
        ),
        "tile": (
            sprites: ["effects/fleck_tile1", "effects/fleck_tile2"],
            size: 1.4,
            speed: 105.0,
            particles: 7,
            duration: 0.35,
            color: (0.50, 0.47, 0.42),
            lit: false,
            decals: ["decals/concrete/shot1", "decals/concrete/shot2", "decals/concrete/shot3", "decals/concrete/shot4", "decals/concrete/shot5"],
            decal_size: 9.0,
            decal_life: 30.0,
            pcf: Some("impact_concrete"),
        ),
        "metal": (
            sprites: ["effects/spark"],
            size: 1.2,
            speed: 150.0,
            particles: 7,
            duration: 0.22,
            color: (1.0, 0.45, 0.12),
            lit: false,
            decals: ["decals/metal/shot1", "decals/metal/shot2", "decals/metal/shot3", "decals/metal/shot4", "decals/metal/shot5"],
            decal_size: 8.0,
            decal_life: 30.0,
            pcf: Some("impact_metal"),
        ),
        "wood": (
            sprites: ["effects/fleck_wood1", "effects/fleck_wood2"],
            size: 1.6,
            speed: 90.0,
            particles: 6,
            duration: 0.42,
            color: (0.38, 0.26, 0.15),
            lit: false,
            decals: ["decals/wood/shot1", "decals/wood/shot2", "decals/wood/shot3", "decals/wood/shot4", "decals/wood/shot5"],
            decal_size: 9.0,
            decal_life: 30.0,
            pcf: Some("impact_wood"),
        ),
        "glass": (
            sprites: ["effects/fleck_glass1", "effects/fleck_glass2", "effects/fleck_glass3"],
            size: 1.2,
            speed: 120.0,
            particles: 8,
            duration: 0.4,
            color: (0.60, 0.62, 0.65),
            lit: false,
            decals: ["decals/glass/shot1", "decals/glass/shot2", "decals/glass/shot3", "decals/glass/shot4", "decals/glass/shot5"],
            decal_size: 9.0,
            decal_life: 30.0,
        ),
        "dirt": (
            sprites: ["effects/fleck_cement1", "effects/fleck_cement2"],
            size: 1.7,
            speed: 80.0,
            particles: 5,
            duration: 0.45,
            color: (0.34, 0.28, 0.20),
            lit: false,
            decals: ["decals/concrete/shot1", "decals/concrete/shot2", "decals/concrete/shot3"],
            decal_size: 10.0,
            decal_life: 30.0,
            pcf: Some("impact_dirt"),
        ),
        "water": (
            sprites: ["effects/splash1", "effects/splash2", "effects/splash3"],
            size: 1.8,
            speed: 90.0,
            particles: 5,
            duration: 0.35,
            color: (0.55, 0.65, 0.72),
            lit: false,
            decals: [],
            decal_size: 8.0,
            decal_life: 0.0,
        ),
    },
    // A bullet through a player: blood thrown out, and the stain it leaves
    // on the floor or wall behind them.
    blood: (
        sprites: ["effects/blood", "effects/blood2"],
        size: 2.6,
        speed: 75.0,
        particles: 8,
        duration: 0.6,
        color: (0.32, 0.006, 0.004),
        lit: true,
        decals: ["decals/flesh/blood1", "decals/flesh/blood2", "decals/flesh/blood3", "decals/flesh/blood4", "decals/flesh/blood5"],
        decal_size: 22.0,
        decal_life: 35.0,
        pcf: Some("blood_impact_red_01"),
    ),
    // A blast is drawn as HL2DM draws it (the client's `explosion` module, from
    // the game's own code: fixed-size puffs of effects/fire_cloud and
    // fire_embers), so only what it does to the view is set here: the view
    // shakes for those near it, `shake` right at the blast down to nothing at
    // three times its radius. HL2DM plays no particle system of its own for
    // it, so there is no `pcf`.
    explosion: (
        shake: 0.85,
    ),
    // A gun's own muzzle flash: the Pulse Rifle's is the Combine one.
    weapon_muzzle_flashes: {
        "rifle": (
            sprites: ["effects/combinemuzzle1", "effects/combinemuzzle2"],
            size: 20.0,
            view_size: 12.0,
            duration: 0.05,
        ),
    },
    // What a weapon's bullets add where they strike, beside the surface's own
    // effect, by weapon id. The Pulse Rifle's is the game's `AR2Impact`: a quad
    // of effects/combinemuzzle2_nocull lying on the surface, 24-32 units
    // (half-size) shrinking to nothing, fading from full, for a quarter of a
    // second, turned at random.
    weapon_flashes: {
        "rifle": (
            sprite: "effects/combinemuzzle2_nocull",
            size: (24.0, 32.0),
            end_size: 0.0,
            size_bias: 0.75,
            alpha: (1.0, 0.0),
            alpha_bias: 0.4,
            life: 0.25,
        ),
    },
    // A thrown grenade: a red dot on its top that flashes with each tick of
    // its fuse (the dot's size at the flash, how bright it stays between
    // ticks, how long a flash takes to fade) and a red trail of where it has
    // been (its life, its width at the grenade and at its far end).
    grenade: (
        dot_size: 9.0,
        dot_offset: (0.0, 0.0, 5.2),
        dot_color: (1.6, 0.08, 0.03),
        dot_dim: 0.4,
        flash_fade: 0.22,
        trail_life: 0.55,
        trail_width: (3.0, 0.3),
        trail_color: (1.4, 0.05, 0.02),
        trail_alpha: 0.85,
    ),
)
