// A player's health, armor and looks, read by `rl_sim::combat`.
Player(
    health: (
        // Health on spawning, and the most health pickups give.
        spawn: 100.0,
        max: 100.0,
    ),
    armor: (
        spawn: 0.0,
        max: 100.0,
        // While it lasts, armor takes this share of every hit...
        absorb: 0.6,
        // ...losing this many points per point of damage it takes.
        cost: 1.0,
    ),
    // Each player is drawn with the next model of this list.
    models: [
        "models/humans/group03/male_07.mdl",
        "models/combine_soldier.mdl",
        "models/humans/group03/female_02.mdl",
        "models/police.mdl",
        "models/humans/group03/male_02.mdl",
        "models/combine_soldier_prisonguard.mdl",
    ],
    // Player models are animated by their own sequences, named
    // <stance>_<hold> as HL2DM's models name them (run_smg1, cidle_pistol);
    // the hold comes from the weapon in hand.
    animation: (
        // Below this speed a player stands still.
        still_speed: 10.0,
        // Running (and crouch-walking) at these speeds plays the sequence
        // at its own pace; other speeds play it faster or slower.
        run_speed: 190.0,
        crouch_speed: 70.0,
        idle: "idle",
        run: "run",
        crouch: "cidle",
        crouch_walk: "cwalk",
        jump: "jump",
        // For weapons whose data names no hold.
        default_hold: "smg1",
        // Seconds over which one sequence fades into the next.
        fade: 0.2,
    ),
)
