// Prop physics tuning: rustlife's own values, read by `rl_sim::physics`.
//
// Lengths are Source units (1 unit = 1 inch), masses kilograms, times
// seconds. Prop masses come from each model's own collision model (.phy);
// see docs/physics.md.
Physics(
    // Downward acceleration of props, units/s². Matches movement.ron's
    // gravity so props and players fall alike.
    gravity: 600.0,
    // Speed limits that keep a badly tangled prop from flying off at
    // absurd speeds: units/s and degrees/s.
    max_speed: 4000.0,
    max_angular_speed: 7200.0,
    // Box3D solver sub-steps per tick: more keeps hard hits and stacks from
    // sinking props into each other, at a higher cost (0 means one).
    ccd_substeps: 4,
    // A prop faster than this is swept against the other props in its way;
    // slower ones are not (resting piles stay cheap), units/s.
    ccd_min_speed: 500.0,
    // Fastest speed at which overlapping props are pushed apart, units/s.
    max_corrective_speed: 300.0,
    // Friction, elasticity (as restitution) and density of every surface in
    // HL2DM's scripts/surfaceproperties.txt, with "base" resolved. Prop
    // masses come from the models' own collision data, so density only sizes
    // a prop that has none. (metal_bouncy and quicksand have elasticities of
    // 1000 and 2 there, which only vphysics tolerates; they are capped at 1.)
    materials: (
        // For surface properties not listed below. A name falls back to its
        // prefix before the last underscore first: "metal_barrel" uses
        // "metal" unless "metal_barrel" is listed itself.
        default: (friction: 0.8, restitution: 0.25, density: 2000.0),
        surfaces: {
            "alienflesh": (friction: 0.8, restitution: 0.25, density: 900.0),
            "armorflesh": (friction: 0.8, restitution: 0.25, density: 900.0),
            "bloodyflesh": (friction: 0.8, restitution: 0.25, density: 900.0),
            "boulder": (friction: 0.8, restitution: 0.2, density: 2400.0),
            "brakingrubbertire": (friction: 0.6, restitution: 0.2, density: 1600.0),
            "brick": (friction: 0.8, restitution: 0.2, density: 2400.0),
            "canister": (friction: 0.8, restitution: 0.2, density: 2700.0),
            "cardboard": (friction: 0.8, restitution: 0.01, density: 500.0),
            "carpet": (friction: 0.8, restitution: 0.01, density: 500.0),
            "ceiling_tile": (friction: 0.8, restitution: 0.01, density: 500.0),
            "chain": (friction: 0.8, restitution: 0.25, density: 1600.0),
            "chainlink": (friction: 0.8, restitution: 0.25, density: 1600.0),
            "computer": (friction: 0.8, restitution: 0.1, density: 2700.0),
            "concrete": (friction: 0.8, restitution: 0.2, density: 2400.0),
            "concrete_block": (friction: 0.8, restitution: 0.2, density: 2400.0),
            "default_silent": (friction: 0.8, restitution: 0.25, density: 2000.0),
            "dirt": (friction: 0.8, restitution: 0.01, density: 1600.0),
            "flesh": (friction: 0.8, restitution: 0.25, density: 900.0),
            "floating_metal_barrel": (friction: 0.8, restitution: 0.1, density: 500.0),
            "floatingstandable": (friction: 0.8, restitution: 0.01, density: 800.0),
            "foliage": (friction: 0.8, restitution: 0.1, density: 700.0),
            "glass": (friction: 0.5, restitution: 0.2, density: 2700.0),
            "glassbottle": (friction: 0.4, restitution: 0.3, density: 2700.0),
            "grass": (friction: 0.8, restitution: 0.01, density: 1600.0),
            "gravel": (friction: 0.4, restitution: 0.2, density: 2400.0),
            "grenade": (friction: 0.9, restitution: 0.01, density: 2700.0),
            "ice": (friction: 0.1, restitution: 0.1, density: 917.0),
            "item": (friction: 0.8, restitution: 0.01, density: 600.0),
            "jeeptire": (friction: 1.337, restitution: 0.2, density: 1600.0),
            "ladder": (friction: 0.8, restitution: 0.25, density: 2700.0),
            "metal": (friction: 0.8, restitution: 0.25, density: 2700.0),
            "metal_barrel": (friction: 0.8, restitution: 0.1, density: 2700.0),
            "metal_bouncy": (friction: 0.0, restitution: 1.0, density: 10000.0),
            "metal_box": (friction: 0.8, restitution: 0.1, density: 2700.0),
            "metalgrate": (friction: 0.8, restitution: 0.25, density: 1600.0),
            "metalpanel": (friction: 0.8, restitution: 0.2, density: 2700.0),
            "metalvent": (friction: 0.8, restitution: 0.1, density: 2700.0),
            "mud": (friction: 0.6, restitution: 0.01, density: 1600.0),
            "no_decal": (friction: 0.8, restitution: 0.25, density: 900.0),
            "paintcan": (friction: 0.3, restitution: 0.99, density: 2700.0),
            "paper": (friction: 0.8, restitution: 0.01, density: 500.0),
            "papercup": (friction: 0.8, restitution: 0.1, density: 500.0),
            "plaster": (friction: 0.8, restitution: 0.01, density: 1600.0),
            "plastic": (friction: 0.8, restitution: 0.01, density: 500.0),
            "plastic_barrel": (friction: 0.8, restitution: 0.01, density: 500.0),
            "plastic_barrel_buoyant": (friction: 0.8, restitution: 0.01, density: 150.0),
            "plastic_box": (friction: 0.8, restitution: 0.01, density: 500.0),
            "player": (friction: 0.5, restitution: 0.001, density: 1000.0),
            "player_control_clip": (friction: 0.8, restitution: 0.25, density: 2000.0),
            "popcan": (friction: 0.3, restitution: 0.99, density: 2700.0),
            "porcelain": (friction: 0.8, restitution: 0.2, density: 2400.0),
            "pottery": (friction: 0.4, restitution: 0.3, density: 2700.0),
            "quicksand": (friction: 0.8, restitution: 1.0, density: 600.0),
            "rock": (friction: 0.8, restitution: 0.2, density: 2400.0),
            "roller": (friction: 0.7, restitution: 0.3, density: 2700.0),
            "rubber": (friction: 0.8, restitution: 0.2, density: 1600.0),
            "rubbertire": (friction: 1.0, restitution: 0.2, density: 1600.0),
            "sand": (friction: 0.8, restitution: 0.01, density: 1600.0),
            "slidingrubbertire": (friction: 0.2, restitution: 0.2, density: 1600.0),
            "slidingrubbertire_front": (friction: 0.2, restitution: 0.2, density: 1600.0),
            "slidingrubbertire_rear": (friction: 0.2, restitution: 0.2, density: 1600.0),
            "slime": (friction: 0.9, restitution: 0.1, density: 2000.0),
            "slipperymetal": (friction: 0.1, restitution: 0.15, density: 2700.0),
            "slipperyslime": (friction: 0.1, restitution: 0.01, density: 1600.0),
            "snow": (friction: 0.35, restitution: 0.01, density: 800.0),
            "solidmetal": (friction: 0.8, restitution: 0.1, density: 2700.0),
            "tile": (friction: 0.8, restitution: 0.3, density: 2700.0),
            "wade": (friction: 0.8, restitution: 0.1, density: 1000.0),
            "wasabiball": (friction: 1.0, restitution: 1.0, density: 1600.0),
            "water": (friction: 0.8, restitution: 0.1, density: 1000.0),
            "watermelon": (friction: 0.8, restitution: 0.25, density: 900.0),
            "weapon": (friction: 0.8, restitution: 0.25, density: 2700.0),
            "wood": (friction: 0.8, restitution: 0.1, density: 700.0),
            "wood_box": (friction: 0.8, restitution: 0.1, density: 700.0),
            "wood_crate": (friction: 0.8, restitution: 0.1, density: 700.0),
            "wood_furniture": (friction: 0.8, restitution: 0.1, density: 700.0),
            "wood_lowdensity": (friction: 0.8, restitution: 0.1, density: 300.0),
            "wood_panel": (friction: 0.8, restitution: 0.1, density: 700.0),
            "wood_plank": (friction: 0.8, restitution: 0.1, density: 700.0),
            "wood_solid": (friction: 0.8, restitution: 0.1, density: 700.0),
            "woodladder": (friction: 0.8, restitution: 0.1, density: 700.0),
        },
    ),
    push: (
        // Players push props as a body this heavy, kg, meeting them head-on:
        // a 5 kg crate is shoved along at walking speed, a 200 kg dumpster
        // creeps.
        player_mass: 85.0,
        // Largest speed change one tick of pushing gives a prop, units/s.
        max_speed_change: 800.0,
        // Props shove players as if the player weighed this much, kg: much
        // less than player_mass, so a 5 kg crate still moves a player and a
        // 50 kg one hurls them along.
        shove_mass: 40.0,
        // Largest speed change one tick of shoving gives a player, units/s.
        max_shove_change: 1200.0,
    ),
    breakables: (
        // The blast of an exploding prop (a barrel) throws players and props
        // about like a rocket's does.
        explosion_knockback: 500.0,
        explosion_force: 90000.0,
        // Source prop_data health is tuned for HL2's damage; weapons do this
        // many times less, so bottles, cardboard boxes and sinks take a few
        // solid hits. Impacts do not: their tables are made for that health.
        weapon_toughness: 3.0,
        // Props striking each other or the map. Closing slower than
        // report_speed is not heard. A second hit between the same two
        // surfaces within repeat_seconds is rubbing and does no harm.
        impact: (
            report_speed: 120.0,
            scrape_speed: 70.0,
            repeat_seconds: 0.25,
            // HL2DM's impactdamagetable_t, read from server.so (see
            // docs/physics.md), by the damage_table a model's prop_data names;
            // "npc" for any other. An impact's energy is
            //   (dv^2 * mass + dv_other^2 * mass_other) / mass * energy_scale
            // and the last step of linear it reaches is the damage, without
            // interpolating. dv comes from the closing speed and the masses.
            //
            // energy_scale is the game's physdamagescale, which defaults to
            // 0.1. Glass keeps it: a 5 hp bottle or vase breaks at 79 units/s,
            // a drop of about 5 units. Everything else has 0.5, our deviation:
            // at 0.1 a 30 hp crate needs a fall of over 1000 units, far tougher
            // than wanted. At 0.5 a crate takes 5 from a 40 unit drop, nothing
            // from a shove into a wall at running pace, and breaks at 495
            // units/s: a fall of about 204 units, or any throw or punt.
            tables: {
                "npc": (
                    energy_scale: 0.5,
                    linear: [(22500.0, 5.0), (62500.0, 10.0), (122500.0, 50.0), (250000.0, 100.0), (1000000.0, 500.0)],
                    angular: [(10000.0, 10.0), (22500.0, 25.0), (40000.0, 50.0), (62500.0, 500.0)],
                min_speed_sqr: 576.0, min_rot_speed_sqr: 129600.0,
                min_mass: 2.0, small_mass_max: 5.0, small_mass_cap: 5.0, small_mass_min_speed_sqr: 1296.0,
                large_mass_min: 500.0, large_mass_scale: 4.0, large_mass_falling_scale: 5.0,
                my_min_speed: 0.0,
                ),
                // The last step is out of order in the game too: 250000 and
                // up reads as 500, and everything from 40000 up to it as 75.
                "glass": (
                    energy_scale: 0.1,
                    linear: [(625.0, 10.0), (2500.0, 20.0), (10000.0, 50.0), (40000.0, 75.0), (250000.0, 100.0), (62500.0, 500.0)],
                    angular: [(2500.0, 25.0), (10000.0, 50.0), (40000.0, 100.0), (62500.0, 500.0)],
                min_speed_sqr: 64.0, min_rot_speed_sqr: 129600.0,
                min_mass: 2.0, small_mass_max: 1.0, small_mass_cap: 10.0, small_mass_min_speed_sqr: 64.0,
                large_mass_min: 50.0, large_mass_scale: 4.0, large_mass_falling_scale: 0.0,
                my_min_speed: 0.0,
                ),
                "player": (
                    energy_scale: 0.5,
                    linear: [(22500.0, 5.0), (62500.0, 10.0), (202500.0, 20.0), (302500.0, 50.0), (490000.0, 100.0), (1000000.0, 500.0)],
                    angular: [(10000.0, 10.0), (22500.0, 20.0), (40000.0, 50.0), (90000.0, 500.0)],
                min_speed_sqr: 576.0, min_rot_speed_sqr: 129600.0,
                min_mass: 2.0, small_mass_max: 5.0, small_mass_cap: 5.0, small_mass_min_speed_sqr: 1296.0,
                large_mass_min: 0.0, large_mass_scale: 1.0, large_mass_falling_scale: 2.0,
                my_min_speed: 320.0,
                ),
                "player_vehicle": (
                    energy_scale: 0.5,
                    linear: [(202500.0, 5.0), (360000.0, 10.0), (490000.0, 25.0), (1000000.0, 50.0), (2250000.0, 100.0), (4000000.0, 500.0)],
                    angular: [(10000.0, 10.0), (22500.0, 20.0), (40000.0, 50.0), (90000.0, 500.0)],
                min_speed_sqr: 576.0, min_rot_speed_sqr: 129600.0,
                min_mass: 80.0, small_mass_max: 150.0, small_mass_cap: 5.0, small_mass_min_speed_sqr: 1296.0,
                large_mass_min: 0.0, large_mass_scale: 1.0, large_mass_falling_scale: 1.0,
                my_min_speed: 0.0,
                ),
            },
        ),
        // Explosive barrels do not break from bullets or knocks. A bullet
        // primes one, a second sets it on fire (it explodes burn_seconds
        // later), a bullet into a burning one, or a swing of a crowbar, sets it off at
        // once. A blast
        // of at least instant_damage at the barrel sets it off; a weaker
        // one sets it on fire with a fuse that is shorter the harder the
        // blast. One thrown or punted with the gravity gun explodes on the
        // first thing it touches, for launched_seconds.
        barrels: (
            burn_seconds: 4.0,
            instant_damage: 60.0,
            longest_fuse: 3.0,
            shortest_fuse: 0.4,
            launched_seconds: 6.0,
        ),
    ),
    impact_damage: (
        // Props must hit at least this fast to hurt, units/s.
        min_speed: 200.0,
        // Impact energy (relative to the player, along the contact) that
        // does no harm, joules...
        min_energy: 300.0,
        // ...and the damage per joule beyond it. A 30 kg barrel thrown at
        // 1000 units/s carries about 9700 J: about 110 damage.
        damage_per_joule: 0.012,
        // Most damage one impact can deal.
        max_damage: 500.0,
    ),
)
