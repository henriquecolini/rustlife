// The Manipulator: rustlife's grab-and-launch physics tool, read by
// `rl_sim::tools::manipulator`.
//
// Lengths are Source units (1 unit = 1 inch), masses kilograms, times
// seconds. How often it acts is in weapons/manipulator.ron, like any
// weapon's rate of fire. See docs/physics.md.
Manipulator(
    // HL2's physcannon_maxmass is 250; its look reaches four times the
    // physcannon_tracelength (250), so far props are pulled in.
    grab: (
        // Props within this distance of the eyes can be grabbed...
        range: 160.0,
        // ...if they weigh at most this, kg.
        max_mass: 250.0,
        // Props farther away, up to this distance, are drawn in while
        // secondary fire is held: slowly at first, then faster, until they
        // are close enough to grab...
        pull_range: 1000.0,
        // ...picking up speed at this rate, units/s², to this top speed,
        // units/s.
        pull_accel: 800.0,
        pull_speed: 500.0,
    ),
    hold: (
        // Gap between the eyes and the near side of the held prop.
        distance: 20.0,
        // The prop closes the gap to its hold point over about this long...
        follow_time: 0.05,
        // ...moving at most this fast (units/s) and turning at most this
        // fast (degrees/s).
        max_speed: 1500.0,
        max_angular_speed: 1080.0,
        // The grip breaks if something holds the prop this far from the
        // hold point for this long.
        break_distance: 64.0,
        break_time: 0.25,
    ),
    // Primary fire on a held prop throws it along the view. From server.so's
    // physcannon force routine: the speed is physcannon_maxforce (1500) up to
    // 100 kg, easing (smoothstep) down to physcannon_minforce (700) at 600 kg,
    // so the factor below is that curve over 1500.
    launch: (
        range: 0.0,
        speed: 1500.0,
        mass_curve: [(0.0, 1.0), (100.0, 1.0), (150.0, 0.985), (200.0, 0.945), (250.0, 0.885), (600.0, 0.4667)],
    ),
    // Primary fire on a prop that is not held knocks it away, a good deal
    // harder than a throw does (the factors are the same curve).
    punt: (
        range: 256.0,
        speed: 2600.0,
        mass_curve: [(0.0, 1.0), (100.0, 1.0), (150.0, 0.985), (200.0, 0.945), (250.0, 0.885), (600.0, 0.4667)],
    ),
)
