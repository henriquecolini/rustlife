// A wall-mounted armor dispenser: holding use at it draws
// a charge a little at a time, then it recharges.
Item(
    name: "Armor station",
    model: "models/props_combine/suit_charger001.mdl",
    gives: Armor(50.0),
    // Seconds it takes to recharge once spent.
    respawn: 60.0,
    // Unused by stations, which are used rather than touched.
    radius: 40.0,
    // Hold use at it to draw its charge at this many points a second.
    station: Some((rate: 25.0)),
    sounds: {"use": "SuitRecharge.ChargingLoop"},
)
