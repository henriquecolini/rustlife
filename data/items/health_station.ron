// A wall-mounted health dispenser: holding use at it draws
// a dose a little at a time, then it recharges.
Item(
    name: "Health station",
    model: "models/props_combine/health_charger001.mdl",
    // The charger's front lies a quarter turn counter-clockwise of the
    // entity's forward axis; turn it to put its front out from the wall the
    // map mounts it on.
    model_yaw: 90.0,
    gives: Health(50.0),
    // Seconds it takes to recharge once spent.
    respawn: 60.0,
    // Unused by stations, which are used rather than touched.
    radius: 40.0,
    // Hold use at it to draw its charge at this many points a second.
    station: Some((rate: 25.0)),
    sounds: {"use": "WallHealth.LoopingContinueCharge"},
)
