// The .357 Magnum. HL2DM's numbers: six rounds of 75 damage, perfectly
// accurate, one shot every 0.75 s. Reloading takes the view model's 3.667 s
// (ACT_VM_RELOAD), drawing it 1.0 s.
Weapon(
    name: ".357 Magnum",
    slot: 2,
    // The letter of this weapon's icon in the game's HL2 icon font.
    icon: Some('e'),
    position: 1,
    weight: 7,
    view_model: Some("models/weapons/v_357.mdl"),
    world_model: "models/weapons/w_357.mdl",
    clip: Some((ammo: "magnum", size: 6, reload: Whole(time: 3.667))),
    primary: Some((
        interval: 0.75,
        automatic: true,
        ammo: Clip(1),
        shot: Hitscan((
            pellets: 1,
            damage: 75.0,
            cone: 0.0,
            range: 56755.0,
            // BULLET_IMPULSE(800 grains, 5000 ft/s).
            force: 10882.0,
        )),
    )),
    secondary: None,
    deploy_time: 1.0,
    pickup: Some((ammo: 0, owned_ammo: 6, respawn: 20.0, radius: 24.0)),
    sounds: {"fire": "Weapon_357.Single", "reload": "Weapon_357.RemoveLoader"},
    // Players hold it with the pistol sequences of HL2DM's player models (run_pistol, ...).
    hold: Some("pistol"),
)
