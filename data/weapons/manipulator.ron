// The Manipulator: grab, carry, throw and punt props. Its grip and throws
// are tuned in tools/manipulator.ron; this file makes it a weapon.
Weapon(
    name: "Gravity Gun",
    slot: 1,
    // The letter of this weapon's icon in the game's HL2 icon font.
    icon: Some('m'),
    position: 2,
    weight: 0,
    // The Gravity Gun is never chosen for the player when a weapon runs dry.
    auto_switch_to: false,
    // Nor does picking up a weapon take it out of your hands.
    auto_switch_from: false,
    view_model: Some("models/weapons/v_physcannon.mdl"),
    world_model: "models/weapons/w_physics.mdl",
    clip: None,
    // Launch the held prop, or punt one in front; then rest this long.
    primary: Some((interval: 0.5, automatic: true, ammo: Unlimited, shot: Manipulator)),
    // Drop, or look for a prop and find none; then rest this long (a grab
    // rests 0.1 s, in tools/manipulator.ron).
    secondary: Some((interval: 0.5, automatic: true, ammo: Unlimited, shot: Manipulator)),
    deploy_time: 0.322,
    pickup: None,
    sounds: {
        "launch": "Weapon_PhysCannon.Launch",
        "punt": "Weapon_PhysCannon.Launch",
        "pickup": "Weapon_PhysCannon.Pickup",
        "drop": "Weapon_PhysCannon.Drop",
        "dryfire": "Weapon_PhysCannon.DryFire",
    },
    // Players hold it with the gravgun sequences of HL2DM's player models (run_gravgun, ...).
    hold: Some("gravgun"),
)
