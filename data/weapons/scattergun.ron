// The Shotgun. HL2DM's numbers: six shells, seven pellets of 9 damage in a
// 10-degree cone for the primary fire; the alternate fire spends two shells
// on twelve pellets (with one shell left it fires the single shot instead).
// A shot holds the gun for the view model's firing animation (0.333 s, the
// double barrel's 0.5 s), then it is pumped for 0.533 s. Reloading takes
// 0.5 s to start and 0.4 s a shell, loaded as each step begins, then 0.433 s
// to close; firing interrupts it once the shell in progress is in. Drawing
// takes 0.733 s.
Weapon(
    name: "Shotgun",
    slot: 4,
    // The letter of this weapon's icon in the game's HL2 icon font.
    icon: Some('b'),
    position: 0,
    weight: 4,
    view_model: Some("models/weapons/v_shotgun.mdl"),
    world_model: "models/weapons/w_shotgun.mdl",
    clip: Some((ammo: "buckshot", size: 6, reload: PerRound(start: 0.5, each: 0.4, finish: 0.433))),
    pump: Some(0.533),
    primary: Some((
        interval: 0.333,
        other_interval: 0.333,
        automatic: true,
        ammo: Clip(1),
        shot: Hitscan((
            pellets: 7,
            damage: 9.0,
            cone: 0.08716,
            range: 56755.0,
            // BULLET_IMPULSE(400 grains, 1200 ft/s), per pellet.
            force: 1306.0,
        )),
    )),
    secondary: Some((
        interval: 0.5,
        other_interval: 0.5,
        automatic: true,
        ammo: Clip(2),
        shot: Hitscan((
            pellets: 12,
            damage: 9.0,
            cone: 0.08716,
            range: 56755.0,
            force: 1306.0,
        )),
    )),
    deploy_time: 0.733,
    pickup: Some((ammo: 0, owned_ammo: 6, respawn: 20.0, radius: 24.0)),
    sounds: {
        "fire": "Weapon_Shotgun.Single",
        "fire2": "Weapon_Shotgun.Double",
        "reload": "Weapon_Shotgun.Reload",
        "pump": "Weapon_Shotgun.Special1",
        "empty": "Weapon_Shotgun.Empty",
    },
    // Players hold it with the shotgun sequences of HL2DM's player models (run_shotgun, ...).
    hold: Some("shotgun"),
)
