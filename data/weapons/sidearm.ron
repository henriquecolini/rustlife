// The 9MM Pistol. HL2DM's numbers: 18 rounds of 8 damage; a held trigger
// fires every 0.5 s but a click fires as soon as 0.1 s after the last shot;
// the cone starts at HL2's 1 degree and opens to 6 as shots are fired
// quickly (each adds 0.2 s of penalty, up to 1.5 s, drained at one second per
// second while the button is up). Reloading takes the view model's 1.433 s
// (ACT_VM_RELOAD), drawing it 0.8 s.
Weapon(
    name: "9MM Pistol",
    slot: 2,
    // The letter of this weapon's icon in the game's HL2 icon font.
    icon: Some('d'),
    position: 0,
    weight: 2,
    view_model: Some("models/weapons/v_pistol.mdl"),
    world_model: "models/weapons/w_pistol.mdl",
    clip: Some((ammo: "pistol", size: 18, reload: Whole(time: 1.433))),
    primary: Some((
        interval: 0.5,
        click_interval: Some(0.1),
        automatic: true,
        ammo: Clip(1),
        shot: Hitscan((
            pellets: 1,
            damage: 8.0,
            cone: 0.00873,
            accuracy: Some((min: 0.00873, max: 0.05234, per_shot: 0.2, full: 1.5)),
            // Source's MAX_TRACE_LENGTH.
            range: 56755.0,
            // BULLET_IMPULSE(200 grains, 1225 ft/s).
            force: 667.0,
        )),
    )),
    secondary: None,
    deploy_time: 0.8,
    pickup: Some((ammo: 0, owned_ammo: 18, respawn: 20.0, radius: 24.0)),
    sounds: {"fire": "Weapon_Pistol.Single", "reload": "Weapon_Pistol.Reload", "empty": "Weapon_Pistol.Empty"},
    // Players hold it with the pistol sequences of HL2DM's player models (run_pistol, ...).
    hold: Some("pistol"),
)
