// The Crossbow. HL2DM's numbers: one bolt in the clip, 100 damage, 3500
// units/s under almost no gravity (30 units/s²). A shot holds the weapon for
// 0.75 s; once the firing animation is over (0.667 s) the next bolt is
// loaded, which takes the view model's 1.833 s, so a bolt leaves about every
// 2.5 s. Drawing it takes 1.0 s. The alternate button toggles a scope that
// narrows the field of view to 20 degrees.
Weapon(
    name: "Crossbow",
    slot: 4,
    // The letter of this weapon's icon in the game's HL2 icon font.
    icon: Some('g'),
    position: 1,
    weight: 6,
    view_model: Some("models/weapons/v_crossbow.mdl"),
    world_model: "models/weapons/w_crossbow.mdl",
    clip: Some((ammo: "bolt", size: 1, reload: Whole(time: 1.833))),
    auto_reload: Some(0.667),
    // The view model's second skin has the bolt glowing (`crossbow
    // dirtmap_glow`, which the game shows while a bolt is loaded). The reload
    // puts it in 0.933 s in (the animation's event 3005).
    loaded_skin: Some((skin: 1, shows_at: 0.933)),
    zoom: Some((fov: 20.0, in_time: 0.1, out_time: 0.2)),
    primary: Some((
        interval: 0.75,
        other_interval: 0.75,
        automatic: true,
        ammo: Clip(1),
        shot: Projectile((
            model: "models/crossbow_bolt.mdl",
            // The bolt's glowing skin (`rebar_glow`, red-hot).
            skin: 1,
            speed: 3500.0,
            lift: 0.0,
            // HL2's SetGravity(0.05).
            gravity: 0.05,
            size: 0.3,
            bounce: None,
            fuse: None,
            hit_damage: 100.0,
            explosion: None,
            lifetime: 10.0,
            // A bolt that meets the map at a shallow angle glances off at
            // three quarters of its speed and then falls under full gravity;
            // otherwise it embeds for two seconds, sparking. It shoves a
            // prop with BULLET_IMPULSE(800 grains, 8000 ft/s).
            ricochet: Some((max_dot: 0.5, min_speed: 100.0, speed_scale: 0.75, gravity: 1.0)),
            stick: Some(2.0),
            impact_force: 17411.0,
            // The bolt's tail glow (sprites/light_glow02_noz, scale 0.2).
            glow: Some((
                halo: "sprites/light_glow02_noz",
                halo_size: 5.0,
                core: "sprites/light_glow02_noz",
                core_size: 2.5,
            )),
        )),
    )),
    secondary: None,
    deploy_time: 1.0,
    pickup: Some((ammo: 4, owned_ammo: 5, respawn: 20.0, radius: 24.0)),
    sounds: {"fire": "Weapon_Crossbow.Single", "reload": "Weapon_Crossbow.Reload"},
    // Players hold it with the crossbow sequences of HL2DM's player models (run_crossbow, ...).
    hold: Some("crossbow"),
)
