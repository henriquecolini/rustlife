// An energy rifle: accurate at range, with a bouncing charge orb that
// shatters whoever it touches.
Weapon(
    name: "Arc Rifle",
    slot: 3,
    position: 1,
    view_model: Some("models/weapons/v_irifle.mdl"),
    world_model: "models/weapons/w_irifle.mdl",
    clip: Some((ammo: "rifle", size: 30, reload: Whole(time: 1.6))),
    primary: Some((
        interval: 0.1,
        automatic: true,
        ammo: Clip(1),
        shot: Hitscan((
            pellets: 1,
            damage: 13.0,
            spread: 2.0,
            range: 8192.0,
            falloff: Some((start: 1536.0, end: 4096.0, min_scale: 0.6)),
            force: 1200.0,
        )),
    )),
    // The orb flies straight, bounces off everything without losing speed
    // and bursts after 3 seconds or on touching a player.
    secondary: Some((
        interval: 1.5,
        automatic: false,
        ammo: Reserve(ammo: "rifle_charge", count: 1),
        shot: Projectile((
            model: "models/effects/combineball.mdl",
            speed: 1100.0,
            lift: 0.0,
            gravity: 0.0,
            size: 8.0,
            bounce: Some(1.0),
            fuse: Some(3.0),
            hit_damage: 100.0,
            explosion: Some((radius: 128.0, damage: 30.0, knockback: 400.0, force: 40000.0)),
            lifetime: 4.0,
        )),
    )),
    deploy_time: 0.5,
    pickup: Some((ammo: 30, respawn: 20.0, radius: 24.0)),
    sounds: {"fire": "Weapon_AR2.Single", "fire2": "Weapon_IRifle.Single", "reload": "Weapon_AR2.Reload"},
    // Players hold it with the ar2 sequences of HL2DM's player models (run_ar2, ...).
    hold: Some("ar2"),
)
