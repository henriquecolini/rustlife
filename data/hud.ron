// The HUD's tunables, read by `rl_client::hud`. How the HUD looks (fonts,
// colours, layout) is the client's theme, not data.
//
// Colours are sRGB with alpha, channels 0..1.
Hud(
    // Health at or below this is shown as a warning.
    low_health: 25.0,
    crosshair: (length: 7.0, thickness: 2.0, gap: 4.0, color: (1.0, 1.0, 1.0, 0.85)),
    kill_feed: (
        // Most kills listed, and how long each stays.
        lines: 5,
        seconds: 6.0,
    ),
)
