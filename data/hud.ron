// The HUD's layout and style, read by `rl_client::hud`.
//
// Elements are placed from a screen anchor (TopLeft, Top, TopRight, Left,
// Center, Right, BottomLeft, Bottom, BottomRight), offset in logical pixels
// towards the centre. Colours are sRGB with alpha, channels 0..1.
Hud(
    font_size: 34.0,
    small_font_size: 16.0,
    colors: (
        text: (0.93, 0.86, 0.62, 0.95),
        warning: (1.0, 0.32, 0.22, 1.0),
        highlight: (1.0, 0.97, 0.85, 1.0),
        panel: (0.0, 0.0, 0.0, 0.38),
    ),
    low_health: 25.0,
    crosshair: (length: 7.0, thickness: 2.0, gap: 4.0, color: (1.0, 1.0, 1.0, 0.85)),
    health: (anchor: BottomLeft, offset: (24.0, 24.0)),
    armor: (anchor: BottomLeft, offset: (190.0, 24.0)),
    ammo: (anchor: BottomRight, offset: (24.0, 24.0)),
    weapons: (anchor: TopLeft, offset: (24.0, 24.0)),
    kill_feed: (
        place: (anchor: TopRight, offset: (24.0, 24.0)),
        lines: 5,
        seconds: 6.0,
    ),
    score: (anchor: Top, offset: (0.0, 18.0)),
    messages: (anchor: Center, offset: (0.0, 90.0)),
)
